# Copy to .env (this folder, or the parent folder) and fill in. Never commit the real .env.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: override the Portkey gateway URL
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Outlook MCP server (mcp/outlook). Client ID of your Entra app registration.
OUTLOOK_CLIENT_ID=your-app-client-id-here
# Tenant ID or domain; "organizations" works for any work/school account.
OUTLOOK_TENANT_ID=organizations
# OUTLOOK_TIMEZONE=Eastern Standard Time
